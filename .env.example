# Basketwise configuration (placeholders only - never commit real values).
# In JacHammer, set these in Settings -> Environment instead of editing .env.

# Retail data provider: mock (default, deterministic demo fixtures) or kroger.
GROCERY_DATA_PROVIDER=mock

# Required only when GROCERY_DATA_PROVIDER=kroger. Server-side only.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Product interpretation: deterministic (default) or llm.
# An API key alone never enables LLM mode.
PRODUCT_INTERPRETER=deterministic

# Used only when PRODUCT_INTERPRETER=llm.
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
